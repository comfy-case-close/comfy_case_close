# ============================================================================
# Environment variables for production deployment on AWS EC2.
# Copy this file to .env.aws, fill in every value, and NEVER commit .env.aws.
# ============================================================================

# ----------------------------------------------------------------------------
# Docker image tag — set by CI to the git SHA, or use 'latest' for manual runs
# ----------------------------------------------------------------------------
IMAGE_TAG=latest

# ----------------------------------------------------------------------------
# Neon PostgreSQL — pooled URL for all Java services (transaction pooling)
# Format: jdbc:postgresql://<host>-pooler.aws.neon.tech/neondb?sslmode=require
# Get this from Neon → Connect → enable pooling → copy JDBC URL
# ----------------------------------------------------------------------------
NEON_POOLER_URL=jdbc:postgresql://REPLACE-pooler.aws.neon.tech/neondb?sslmode=require

# ----------------------------------------------------------------------------
# Per-service database passwords — each svc_* role has its own password.
# Set with: ALTER ROLE svc_identity PASSWORD '<password>';
# See docs/railway-neon.md §3 for the full setup procedure.
# ----------------------------------------------------------------------------
SVC_IDENTITY_DB_PASSWORD=REPLACE
SVC_PLATFORM_DB_PASSWORD=REPLACE
SVC_FILES_DB_PASSWORD=REPLACE
SVC_NOTIFY_DB_PASSWORD=REPLACE
SVC_INTEGRATION_DB_PASSWORD=REPLACE
SVC_CASHCLOSE_DB_PASSWORD=REPLACE
SVC_WORKFORCE_DB_PASSWORD=REPLACE
SVC_INVENTORY_DB_PASSWORD=REPLACE
SVC_REPORTING_DB_PASSWORD=REPLACE

# ----------------------------------------------------------------------------
# JWT — shared secret for all services that issue or verify tokens.
# Generate once: openssl rand -base64 33
# Must be the SAME value on identity, gateway, and every downstream service.
# ----------------------------------------------------------------------------
JWT_SECRET=REPLACE

# ----------------------------------------------------------------------------
# Platform admin key — guards POST /businesses and related provisioning endpoints.
# Generate: openssl rand -base64 33    (at least 32 random characters)
# ----------------------------------------------------------------------------
PLATFORM_ADMIN_KEY=REPLACE

# ----------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# ----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# ----------------------------------------------------------------------------
# Frontend URLs — used by cashclose to build email links
# ----------------------------------------------------------------------------
FRONTEND_BASE_URL=https://your-frontend-domain.com
CASH_CLOSE_REVIEW_PATH_TEMPLATE=/approvals?cashCloseId={id}
CASH_CLOSE_SUBMITTER_PATH_TEMPLATE=/history?cashCloseId={id}

# ----------------------------------------------------------------------------
# Google OAuth — client ID for Google Sign-In (identity service)
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=REPLACE.apps.googleusercontent.com

# ----------------------------------------------------------------------------
# Email delivery — used by identity and cashclose
# Option A: SMTP (set MAIL_PROVIDER=smtp)
# Option B: Resend (set MAIL_PROVIDER=resend, leave SMTP fields blank)
# ----------------------------------------------------------------------------
MAIL_PROVIDER=smtp
MAIL_ENABLED=true
MAIL_FROM=noreply@your-domain.com

SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE
SMTP_PASSWORD=REPLACE

# Leave blank if using SMTP:
RESEND_API_KEY=

# ----------------------------------------------------------------------------
# Google Cloud Storage — used by files service
# Set GCS_ENABLED=false to disable file uploads until GCS is configured.
# When enabling: place the service-account JSON key on the EC2 host at
# GCS_KEY_HOST_PATH and set GCS_SERVICE_ACCOUNT_KEY to /secrets/gcs-key.json
# ----------------------------------------------------------------------------
GCS_ENABLED=false
GCS_BUCKET_NAME=your-gcs-bucket-name
GCS_KEY_HOST_PATH=/opt/fnbx/secrets
GCS_SERVICE_ACCOUNT_KEY=/secrets/gcs-key.json
GCS_OBJECT_PREFIX=case-close
GCS_SIGNED_URL_TTL_MINUTES=60
GCS_MAX_FILE_SIZE_BYTES=10485760
