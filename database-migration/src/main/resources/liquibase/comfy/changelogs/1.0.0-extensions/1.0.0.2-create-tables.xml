    <!-- ==================================================================== -->
    <!-- Derived views: monthly_report (materialized) + dashboard             -->
    <!-- ==================================================================== -->
    <changeSet id="1.0.0.2-18-create-views" author="TuanNguyen">
        <sql splitStatements="false">
            CREATE MATERIALIZED VIEW monthly_report AS
            SELECT
              DATE_TRUNC('month', cc.business_date)::DATE                        AS month,
              cc.branch_id,
              b.branch_name,
              COUNT(*)                                                            AS total_shift_close,
              SUM(cc.pos_expected_cash)                                           AS total_pos_expected_cash,
              SUM(cc.counted_cash)                                                AS total_counted_cash,
              SUM(cc.pos_expected_cash - cc.counted_cash)                         AS total_cash_diff,
              SUM(GREATEST(cc.pos_expected_cash - cc.counted_cash, 0))            AS total_shortage,
              SUM(LEAST(cc.pos_expected_cash - cc.counted_cash, 0))              AS total_surplus,
              SUM(cc.withdrawal_amount)                                           AS total_withdrawal,
              SUM(t.tips_total)                                                   AS total_tips,
              SUM(e.expense_total)                                                AS total_expense,
              COUNT(*) FILTER (WHERE cc.risk_level = 'HIGH')                      AS warning_count,
              COUNT(*) FILTER (WHERE cc.status = 'PENDING_REVIEW')               AS pending_review_count,
              COUNT(*) FILTER (WHERE cc.status = 'APPROVED')                      AS approved_count,
              now()                                                              AS refreshed_at
            FROM cash_closes cc
            JOIN branches b ON b.id = cc.branch_id
            LEFT JOIN LATERAL (
              SELECT SUM(amount) AS tips_total FROM tips WHERE cash_close_id = cc.id
            ) t ON TRUE
            LEFT JOIN LATERAL (
              SELECT SUM(amount) AS expense_total
              FROM cash_movements WHERE cash_close_id = cc.id AND movement_type = 'EXPENSE'
            ) e ON TRUE
            WHERE cc.status != 'VOIDED'
            GROUP BY DATE_TRUNC('month', cc.business_date), cc.branch_id, b.branch_name;
        </sql>
        <sql>
            CREATE UNIQUE INDEX idx_monthly_report_month_branch ON monthly_report (month, branch_id);
        </sql>
        <sql splitStatements="false">
            CREATE VIEW dashboard AS
            WITH base AS (SELECT * FROM cash_closes WHERE status != 'VOIDED')
            SELECT 'total_shifts'         AS metric, COUNT(*)::TEXT                       AS value FROM base
            UNION ALL
            SELECT 'total_pos_expected',             SUM(pos_expected_cash)::TEXT          FROM base
            UNION ALL
            SELECT 'total_counted',                  SUM(counted_cash)::TEXT               FROM base
            UNION ALL
            SELECT 'total_cash_diff',               SUM(pos_expected_cash - counted_cash)::TEXT FROM base
            UNION ALL
            SELECT 'total_withdrawal',               SUM(withdrawal_amount)::TEXT          FROM base
            UNION ALL
            SELECT 'pending_review_count',           COUNT(*) FILTER (WHERE status = 'PENDING_REVIEW')::TEXT FROM base;
        </sql>
        <rollback>
            <sql>
                DROP VIEW IF EXISTS dashboard;
                DROP MATERIALIZED VIEW IF EXISTS monthly_report;
            </sql>
        </rollback>
    </changeSet>

