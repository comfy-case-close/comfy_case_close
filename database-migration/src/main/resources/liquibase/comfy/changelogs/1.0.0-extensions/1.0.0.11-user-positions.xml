    <changeSet id="1.0.0.7-2-create-user-positions" author="codex">
        <createTable tableName="user_positions" remarks="Junction: user assigned staff positions">
            <column name="user_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_user_positions" nullable="false"/>
            </column>
            <column name="staff_position_code" type="VARCHAR(50)">
                <constraints primaryKey="true" primaryKeyName="pk_user_positions" nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="user_positions" baseColumnNames="user_id"
                referencedTableName="users" referencedColumnNames="id"
                constraintName="fk_user_positions_user_id" onDelete="CASCADE"/>
        <addForeignKeyConstraint
                baseTableName="user_positions" baseColumnNames="staff_position_code"
                referencedTableName="staff_positions" referencedColumnNames="code"
                constraintName="fk_user_positions_staff_position_code"/>
        <rollback>
            <dropTable tableName="user_positions"/>
        </rollback>
    </changeSet>

    <changeSet id="1.0.0.7-3-migrate-users-position" author="codex">
        <sql>
            INSERT INTO user_positions (user_id, staff_position_code)
            SELECT u.id, sp.code
            FROM users u
            JOIN staff_positions sp ON sp.display_title = u.position
            WHERE u.position IS NOT NULL
              AND TRIM(u.position) &lt;&gt; ''
        </sql>
        <dropColumn tableName="users" columnName="position"/>
        <rollback>
            <addColumn tableName="users">
                <column name="position" type="VARCHAR(100)"/>
            </addColumn>
            <sql>
                UPDATE users u
                SET position = sp.display_title
                FROM user_positions up
                JOIN staff_positions sp ON sp.code = up.staff_position_code
                WHERE up.user_id = u.id
                  AND u.position IS NULL
            </sql>
        </rollback>
    </changeSet>
</databaseChangeLog>
