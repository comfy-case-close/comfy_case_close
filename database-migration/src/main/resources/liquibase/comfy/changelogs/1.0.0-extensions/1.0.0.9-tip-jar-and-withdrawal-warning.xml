<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <changeSet id="1.0.0.9-1-create-tip-payouts" author="claude">
        <createTable tableName="tip_payouts" remarks="Cash paid out of a branch's tip jar to staff">
            <column name="id" type="BIGINT" autoIncrement="true" generationType="ALWAYS">
                <constraints primaryKey="true" primaryKeyName="pk_tip_payouts" nullable="false"/>
            </column>
            <column name="branch_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="payout_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="recipient_name" type="VARCHAR(100)"/>
            <column name="note" type="TEXT"/>
            <column name="created_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="tip_payouts" baseColumnNames="branch_id"
                referencedTableName="branches" referencedColumnNames="id"
                constraintName="fk_tip_payouts_branch_id"/>
        <addForeignKeyConstraint
                baseTableName="tip_payouts" baseColumnNames="created_by"
                referencedTableName="users" referencedColumnNames="id"
                constraintName="fk_tip_payouts_created_by"/>
        <sql>
            ALTER TABLE tip_payouts ADD CONSTRAINT ck_tip_payouts_amount CHECK (amount > 0);
        </sql>
        <createIndex tableName="tip_payouts" indexName="idx_tip_payouts_branch_date">
            <column name="branch_id"/>
            <column name="payout_date"/>
        </createIndex>
        <rollback>
            <dropTable tableName="tip_payouts"/>
        </rollback>
    </changeSet>

    <changeSet id="1.0.0.9-2-app-config-fund-withdrawal-warning" author="claude">
        <addColumn tableName="app_config">
            <column name="fund_withdrawal_warning_abs" type="BIGINT" defaultValueNumeric="50000000">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="app_config" columnName="fund_withdrawal_warning_abs"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
